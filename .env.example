# ============================================================
# HealthSync — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then start the stack:
#   docker-compose up --build
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_USERNAME=prescription_user
DB_PASSWORD=change_me_strong_password_here

# ── JWT Secret ───────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Email (Gmail SMTP) ────────────────────────────────────────
# Use a Gmail App Password (not your main password):
# Google Account → Security → 2-Step Verification → App Passwords
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password

# ── Cloudflare R2 Storage ─────────────────────────────────────
# 1. Go to dash.cloudflare.com → R2 → Create bucket
# 2. API Tokens → Create token with Object Read & Write
# 3. Enable "Public access" on the bucket to get R2_PUBLIC_URL
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=healthsync-uploads
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXX.r2.dev

# ── CORS (comma-separated origins, no trailing slash) ─────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── CI/CD only (not used locally) ────────────────────────────
# Add these as GitHub Actions secrets, not in this file
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token
# AZURE_VM_HOST=74.225.140.65
# AZURE_VM_USERNAME=azureuser
# AZURE_VM_SSH_KEY=<paste private key content>
